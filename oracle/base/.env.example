# container-registry.oracle.com 로그인용 자격증명 (19c Enterprise Edition 전용)
# 21c-xe / 18c-xe(gvenzl 커뮤니티 이미지)는 이 파일이 필요 없습니다.
#
# 사용법:
#   1) 이 파일을 .env로 복사 (또는 .env를 직접 아래 형식으로 생성)
#   2) ORACLE_AUTH_TOKEN 값을 https://container-registry.oracle.com 계정 아이콘 > Auth Token 메뉴에서
#      발급받은 토큰으로 직접 채워넣기 (수기 입력 — 절대 커밋 금지, .gitignore에 등록되어 있음)
#   3) build-and-push.sh/.ps1 실행 시 자동으로 이 값을 읽어 docker login에 사용

ORACLE_REGISTRY_USER=sadviolent@gmail.com
ORACLE_AUTH_TOKEN=
