# 로컬 전용 설정 (VSCode 확장 등, 사람/머신마다 다를 수 있음)
.claude/settings.local.json

# 실행 시 자동 생성되는 환경설정 (예시 파일은 .env.example로 추적)
oracle/registry/.env
oracle/base/.env

# 배포 스크립트가 실행 중 생성하는 임시 스테이징 폴더
oracle/deploy/.staging/

# 실행 로그/테스트용 임시 산출물 (생성된 비밀번호 등 민감정보가 찍힐 수 있음 — 절대 커밋 금지)
oracle/**/.*-log.txt
oracle/**/.answers.txt

# OS/에디터 잡동사니
.DS_Store
Thumbs.db
