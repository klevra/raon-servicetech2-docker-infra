# 로컬 전용 설정 (VSCode 확장 등, 사람/머신마다 다를 수 있음)
.claude/settings.local.json
# 세션 실행 중에만 의미 있는 임시 락 파일 (PID/세션ID/타임스탬프, 커밋 대상 아님)
.claude/scheduled_tasks.lock

# 실행 시 자동 생성되는 환경설정 (예시 파일은 .env.example로 추적)
oracle/registry/.env
oracle/base/.env

# 배포 스크립트가 실행 중 생성하는 임시 스테이징 폴더 (oracle/deploy, mariadb/deploy 등 공통)
**/deploy/.staging/

# 실행 로그/테스트용 임시 산출물 (생성된 비밀번호 등 민감정보가 찍힐 수 있음 — 절대 커밋 금지)
**/.*-log.txt
**/.answers.txt

# deploy.sh/.ps1의 "실행 요약/접속 정보 로그 저장" 기능(opt-in)이 만드는 파일 — 평문 비밀번호 포함, 절대 커밋 금지
**/deploy/logs/

# docker save로 생성되는 대용량 이미지 tar 파일 (수동 전송용, 절대 커밋 금지)
*.tar

# 로컬 빌드 산출물 (Maven 등으로 재생성 가능, 커밋 대상 아님)
**/sample/out/

# OS/에디터 잡동사니
.DS_Store
Thumbs.db
